---
/* Documento base: <head> completo (SEO, Open Graph, Twitter, JSON-LD Book + Person +
   FAQPage + WebSite), fuentes y estilos globales. Los datos estructurados se generan desde
   src/content, así siempre coinciden con lo que se ve en la página. Las páginas legales
   pasan structuredData={false} y su propio título, descripción y ruta. */
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "../styles/global.css";
import { SITE_URL, AMAZON_URL, INSTAGRAM_URL, seo, bookJsonLd, author } from "../content/site";
import { faq, resenas } from "../content/copy";

interface Props {
  title?: string;
  description?: string;
  /** ruta canónica, p. ej. "/" o "/privacidad" */
  path?: string;
  structuredData?: boolean;
}
const { title = seo.title, description = seo.description, path = "/", structuredData = true } = Astro.props;
const url = `${SITE_URL}${path}`;

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE_URL}/#autora`,
  name: author.name,
  alternateName: author.fullName,
  url: `${SITE_URL}/#autora`,
  image: `${SITE_URL}${author.photo}`,
  jobTitle: "Escritora",
  sameAs: [INSTAGRAM_URL, AMAZON_URL],
};

const stripHtml = (s: string) => s.replace(/<br\s*\/?>/g, " ").replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();

const fullBookJsonLd = {
  ...bookJsonLd,
  author: { "@id": personJsonLd["@id"] },
  offers: {
    "@type": "Offer",
    url: AMAZON_URL,
    availability: "https://schema.org/InStock",
    priceCurrency: "EUR",
    seller: { "@type": "Organization", name: "Amazon" },
  },
  review: resenas.items.map((r) => ({
    "@type": "Review",
    name: r.title,
    reviewBody: stripHtml(r.quoteHtml).replace(/^[“"]|[”"]$/g, ""),
    author: { "@type": "Person", name: r.author.split(" · ")[0] },
    reviewRating: { "@type": "Rating", ratingValue: "5", bestRating: "5" },
  })),
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Espíritu Salvaje",
  url: `${SITE_URL}/`,
  inLanguage: "es",
  about: { "@id": `${SITE_URL}/#libro` },
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <!-- Marca <html class="js"> antes del primer pintado: la intro y el rastro sólo existen con JS. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author.name} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#061003" />
    <meta property="og:type" content={structuredData ? "book" : "website"} />
    <meta property="og:site_name" content="Espíritu Salvaje" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:image:width" content={String(seo.ogImageWidth)} />
    <meta property="og:image:height" content={String(seo.ogImageHeight)} />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    {structuredData && <meta property="book:author" content={author.name} />}
    {structuredData && <meta property="book:isbn" content={bookJsonLd.isbn} />}
    {structuredData && <meta property="book:release_date" content={bookJsonLd.datePublished} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={seo.ogImage} />
    <meta name="twitter:image:alt" content={seo.ogImageAlt} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(fullBookJsonLd)} />}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />}
    <!-- Las tres caras de Fraunces que pintan el primer viewport -->
    <link rel="preload" href="/fonts/Fraunces144ptSoft-Light.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Fraunces144ptSoft-LightItalic.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Fraunces144ptSoft-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
