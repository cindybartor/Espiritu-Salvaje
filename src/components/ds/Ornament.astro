---
/* Ornamento tipográfico (de Ornament.jsx): marca el respiro entre bloques. */
interface Props { variant?: "stars" | "vertical" | "rule" | "wound"; count?: number; class?: string }
const { variant = "stars", count = 3, class: className } = Astro.props;
---
{variant === "vertical" && <div class:list={["orn-vertical", className]} aria-hidden="true"></div>}
{variant === "rule" && <div class:list={["orn-rule", className]} aria-hidden="true"></div>}
{variant === "wound" && <div class:list={["orn-wound", className]} aria-hidden="true"></div>}
{variant === "stars" && <div class:list={["orn-stars", className]} aria-hidden="true">{Array.from({ length: count }, () => "✦").join(" ")}</div>}

<style>
  .orn-vertical { width: 1px; height: 80px; background: var(--rule-vertical); opacity: .4; margin: 0 auto; }
  .orn-rule { width: 100%; height: 1px; background: var(--rule-gold); opacity: .4; }
  .orn-wound { width: 100%; height: 2px; background: var(--rule-blood); opacity: .4; }
  .orn-stars { font-family: var(--font-display); font-size: 20px; letter-spacing: 12px; color: var(--accent-primary); opacity: .5; text-align: center; }
</style>
