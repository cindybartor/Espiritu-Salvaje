---
/* Enlace-CTA subrayado (de LinkCta.jsx). */
interface Props { href: string; arrow?: boolean; class?: string }
const { href, arrow = true, class: className } = Astro.props;
---
<a href={href} class:list={["es-linkcta", className]}><slot />{arrow && " →"}</a>

<style>
  .es-linkcta {
    display: inline-block;
    font-family: var(--font-ui); font-size: var(--type-label); font-weight: 500;
    letter-spacing: var(--track-label); text-transform: uppercase; text-decoration: none;
    padding: 12px 0; padding-left: 0;
    color: var(--accent-primary);
    border-bottom: 1px solid var(--accent-primary);
    transition: all var(--dur-fast) var(--ease);
  }
  .es-linkcta:hover { padding-left: 8px; color: var(--text-heading); border-bottom-color: var(--text-heading); }
</style>
