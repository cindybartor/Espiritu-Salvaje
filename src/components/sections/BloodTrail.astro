---
/* Rastro de sangre tras el puntero: 8 gotas radiales con mix-blend-mode: multiply que
   siguen al ratón con retardos crecientes (src/scripts/trail.ts). Apagado con hover: none
   y con prefers-reduced-motion. */
const DOTS = [
  { s: 34, a: [.78, .4], c: "42%", st: "48%", e: "74%", b: 5, t: 160 },
  { s: 30, a: [.66, .32], c: "45%", st: "50%", e: "76%", b: 5, t: 380 },
  { s: 26, a: [.56, .26], c: "45%", st: "52%", e: "78%", b: 6, t: 700 },
  { s: 22, a: [.46, .2], c: "48%", st: "54%", e: "80%", b: 6, t: 1100 },
  { s: 18, a: [.38, .16], c: "50%", st: "56%", e: "82%", b: 6, t: 1600 },
  { s: 15, a: [.3, .12], c: "50%", st: "58%", e: "84%", b: 5, t: 2200 },
  { s: 12, a: [.24, .1], c: "50%", st: "60%", e: "86%", b: 5, t: 2900 },
  { s: 9, a: [.18, .07], c: "50%", st: "62%", e: "88%", b: 4, t: 3600 },
];
---
<div class="es-trail" data-trail aria-hidden="true">
  {DOTS.map((d) => (
    <div
      class="dot"
      data-trail-dot
      style={`width:${d.s}px;height:${d.s}px;margin:${-d.s / 2}px 0 0 ${-d.s / 2}px;background:radial-gradient(circle at 50% ${d.c}, rgba(87,5,3,${d.a[0]}) 0%, rgba(87,5,3,${d.a[1]}) ${d.st}, rgba(87,5,3,0) ${d.e});filter:blur(${d.b}px);transition:transform ${d.t}ms cubic-bezier(.22,1,.36,1)`}
    ></div>
  ))}
</div>

<style>
  .es-trail {
    position: fixed; inset: 0; z-index: 9997; pointer-events: none;
    mix-blend-mode: multiply; opacity: 0; transition: opacity 1.2s var(--ease);
  }
  .es-trail.is-on { opacity: 1; }
  .dot { position: absolute; top: 0; left: 0; border-radius: 50%; }
  @media (hover: none), (prefers-reduced-motion: reduce) { .es-trail { display: none; } }
</style>
