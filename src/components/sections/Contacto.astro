---
/* #contacto: formulario que llega directamente al correo de la autora vía Netlify Forms
   (sin backend: Netlify detecta el <form data-netlify> en el HTML estático y envía la
   notificación al correo configurado en el panel de Netlify). Tras enviar, Netlify
   redirige a /?enviado=1#contacto y src/scripts/contact.ts muestra el agradecimiento. */
import Section from "../ds/Section.astro";
import Eyebrow from "../ds/Eyebrow.astro";
import SectionTitle from "../ds/SectionTitle.astro";
import Typed from "../ds/Typed.astro";
import Button from "../ds/Button.astro";
import { contacto } from "../../content/copy";
---
<Section id="contacto" tone="page" glow="gold" maxWidth="var(--measure-prose)">
  <div class="block" data-reveal="block">
    <div class="head">
      <Eyebrow align="left">{contacto.eyebrow}</Eyebrow>
      <SectionTitle level={2} size="display-2"><Typed lines={contacto.titleLines} /></SectionTitle>
      <p class="intro">{contacto.intro}</p>
    </div>

    <form name="contacto" method="POST" action="/?enviado=1#contacto" data-netlify="true" netlify-honeypot="bot-field" class="form" data-contact-form>
      <input type="hidden" name="form-name" value="contacto" />
      <p class="hp" aria-hidden="true"><label>No rellenes este campo: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

      <div class="row">
        <label class="field">
          <span class="label">{contacto.name}</span>
          <input type="text" name="nombre" autocomplete="name" required />
        </label>
        <label class="field">
          <span class="label">{contacto.email}</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
      </div>
      <label class="field">
        <span class="label">{contacto.message}</span>
        <textarea name="mensaje" rows="6" required></textarea>
      </label>

      <div class="actions">
        <Button variant="outline" arrow type="submit">{contacto.submit}</Button>
        <span class="note">{contacto.note}</span>
      </div>
    </form>

    <p class="success" data-contact-success hidden>{contacto.success}</p>
  </div>
</Section>

<style>
  .block { display: flex; flex-direction: column; gap: clamp(40px, 6vw, 64px); }
  .head { display: flex; flex-direction: column; gap: var(--space-5); }
  .intro {
    margin: 0; font-family: var(--font-ui); font-weight: 300;
    font-size: var(--type-body); line-height: var(--lh-body); color: var(--text-body); text-wrap: pretty;
  }
  .form { display: flex; flex-direction: column; gap: var(--space-6); }
  .form[hidden] { display: none; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; margin: 0; }
  .row { display: grid; grid-template-columns: 1fr; gap: var(--space-6); }
  @media (min-width: 640px) { .row { grid-template-columns: 1fr 1fr; } }
  .field { display: flex; flex-direction: column; gap: var(--space-3); }
  .label {
    font-family: var(--font-ui); font-size: var(--type-eyebrow); font-weight: 400;
    letter-spacing: var(--track-eyebrow); text-transform: uppercase; color: var(--accent-primary); opacity: .85;
  }
  input, textarea {
    width: 100%; margin: 0;
    padding: 16px 18px;
    font-family: var(--font-ui); font-weight: 300; font-size: var(--type-body); line-height: 1.5;
    color: var(--text-heading);
    background: rgba(6, 16, 3, .35);
    border: 1px solid var(--border-hairline); border-radius: var(--radius-none);
    outline: none;
    transition: border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  textarea { resize: vertical; min-height: 160px; }
  input:focus, textarea:focus { border-color: var(--accent-primary); background: rgba(6, 16, 3, .55); }
  input:-webkit-autofill, textarea:-webkit-autofill { -webkit-text-fill-color: var(--text-heading); box-shadow: 0 0 0 1000px #0b1a09 inset; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-5) var(--space-7); margin-top: var(--space-2); }
  .note { font-family: var(--font-ui); font-size: var(--type-fine); letter-spacing: .12em; text-transform: uppercase; color: var(--text-muted); }
  .success {
    margin: 0; padding: 32px 24px; text-align: center;
    border-top: 1px solid var(--border-hairline); border-bottom: 1px solid var(--border-hairline);
    font-family: var(--font-display); font-weight: 300; font-style: italic;
    font-size: clamp(22px, 2.1vw, 28px); line-height: 1.5; color: var(--accent-primary);
  }
  .success[hidden] { display: none; }
</style>
