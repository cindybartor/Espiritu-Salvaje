---
/* Franja parallax con el fondo botánico: esDrift ligado al scroll (animation-range: cover). */
import { Image } from "astro:assets";
import botanico from "../../assets/uploads/fondo-botanico-web.png";
interface Props { alt: string }
const { alt } = Astro.props;
---
<div class="band" aria-hidden="true">
  <Image src={botanico} alt={alt} widths={[640, 1024, 1296]} sizes="100vw" format="webp" loading="lazy" class="img" data-parallax />
  <div class="veil"></div>
</div>

<style>
  .band { position: relative; height: clamp(220px, 32vw, 420px); background: var(--bg-night); overflow: clip; }
  .img {
    position: absolute; top: -8%; left: 0; width: 100%; height: 116%;
    object-fit: cover; object-position: center 60%; opacity: .9;
    animation: esDrift linear both; animation-timeline: view(); animation-range: cover;
  }
  .veil { position: absolute; inset: 0; background: radial-gradient(ellipse 78% 115% at 50% 45%, transparent 26%, rgba(6, 16, 3, .8) 100%); pointer-events: none; }
</style>
