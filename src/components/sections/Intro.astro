---
/* Cortina de intro: vídeo a pantalla completa sobre fondo noche. La lógica (sonido,
   saltar, fin del vídeo, failsafe de 20 s, fundido de 0,9 s) está en src/scripts/intro.ts.
   Sin JavaScript no se muestra (ver global.css). */
import { intro } from "../../content/copy";
---
<div class="es-intro" data-intro>
  <video src={intro.video} autoplay playsinline preload="auto" aria-hidden="true"></video>
  <div class="vignette" aria-hidden="true"></div>
  <button type="button" class="btn sound" data-intro-sound aria-label={intro.soundOff}>{intro.soundOff}</button>
  <button type="button" class="btn skip" data-intro-skip>{intro.skip}</button>
</div>

<style>
  .es-intro {
    position: fixed; inset: 0; z-index: 9999;
    background: var(--bg-night);
    display: flex; align-items: center; justify-content: center;
    opacity: 1; transition: opacity .9s var(--ease);
  }
  .es-intro.is-fading { opacity: 0; pointer-events: none; }
  video {
    position: absolute; top: 50%; left: 50%; width: 100%; height: 100%;
    transform: translate(-50%, -50%); object-fit: cover;
  }
  .vignette { position: absolute; inset: 0; background: var(--vignette); pointer-events: none; }
  .btn {
    position: absolute; bottom: clamp(20px, 4vw, 44px);
    min-height: 44px; padding: 12px 22px;
    border: 1px solid var(--border-strong); background: rgba(6, 16, 3, .55);
    color: var(--text-heading);
    font-family: var(--font-ui); font-size: 13px; font-weight: 400;
    letter-spacing: var(--track-nav); text-transform: uppercase; cursor: pointer;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .btn:hover { border-color: var(--accent-primary); color: var(--accent-primary); }
  .sound { left: clamp(20px, 4vw, 44px); }
  .skip { right: clamp(20px, 4vw, 44px); }
</style>
