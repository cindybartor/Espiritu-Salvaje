---
/* #faq: seis preguntas siempre abiertas, separadas por filetes. Las mismas alimentan el
   JSON-LD FAQPage en Base.astro. */
import Section from "../ds/Section.astro";
import Eyebrow from "../ds/Eyebrow.astro";
import SectionTitle from "../ds/SectionTitle.astro";
import Typed from "../ds/Typed.astro";
import Monogram from "../ds/Monogram.astro";
import { faq } from "../../content/copy";
---
<Section id="faq" tone="night" glow="wound" maxWidth="var(--measure-quote)">
  <Monogram slot="bleed" size="min(60vw, 520px)" opacity={0.04} class="watermark" />
  <div class="block" data-reveal="block">
    <div class="head">
      <Eyebrow align="left">{faq.eyebrow}</Eyebrow>
      <SectionTitle level={2} size="display-2"><Typed lines={faq.titleLines} /></SectionTitle>
    </div>
    <div class="list">
      {faq.items.map((item) => (
        <div class="item">
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </div>
      ))}
    </div>
  </div>
</Section>

<style>
  .block { display: flex; flex-direction: column; gap: clamp(40px, 6vw, 64px); }
  :global(#faq .watermark) { position: absolute; left: -8%; top: 8%; z-index: 0; }
  .head { display: flex; flex-direction: column; gap: var(--space-5); }
  .list { display: flex; flex-direction: column; }
  .item { border-top: 1px solid var(--border-hairline); padding: clamp(24px, 4vw, 32px) 0; }
  .item:last-child { border-bottom: 1px solid var(--border-hairline); }
  h3 {
    margin: 0 0 var(--space-4); font-family: var(--font-display); font-weight: 300; font-style: italic;
    font-size: var(--type-lede-lg); line-height: var(--lh-lede-lg); color: var(--accent-primary);
  }
  p {
    margin: 0; max-width: var(--measure-prose);
    font-family: var(--font-ui); font-weight: 300; font-size: var(--type-body); line-height: var(--lh-body);
    color: var(--text-body); text-wrap: pretty;
  }
</style>
