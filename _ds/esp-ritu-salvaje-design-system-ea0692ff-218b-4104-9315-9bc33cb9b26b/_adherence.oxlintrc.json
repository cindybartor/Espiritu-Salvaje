{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/atmosphere/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fraunces Soft|Renaissance|Inter))/i]",
        "message": "Font not provided by the design system. Available: Fraunces Soft, Renaissance, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookCover'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|placeholder|style|key|ref|className|style|children)$/]",
        "message": "<BookCover> doesn't accept that prop. Declared props: src, alt, ratio, placeholder, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|children|arrow|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, children, arrow, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|solid|nav)$/]",
        "message": "<Button> variant must be one of 'outline' | 'solid' | 'nav'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|id|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, onChange, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|rules|align|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, rules, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Eyebrow> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|placeholder|value|onChange|multiline|required|id|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, type, placeholder, value, onChange, multiline, required, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkCta'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|children|arrow|style|key|ref|className|style|children)$/]",
        "message": "<LinkCta> doesn't accept that prop. Declared props: href, children, arrow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MarkedList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<MarkedList> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|links|cta|ctaHref|compact|position|style|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: brand, links, cta, ctaHref, compact, position, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:fixed|absolute|static)$/]",
        "message": "<NavBar> position must be one of 'fixed' | 'absolute' | 'static'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NightBackdrop'] > JSXAttribute > JSXIdentifier[name!=/^(?:drops|embers|vignette|sideShadows|style|key|ref|className|style|children)$/]",
        "message": "<NightBackdrop> doesn't accept that prop. Declared props: drops, embers, vignette, sideShadows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ornament'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|count|style|key|ref|className|style|children)$/]",
        "message": "<Ornament> doesn't accept that prop. Declared props: variant, count, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ornament'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:stars|vertical|rule|wound)$/]",
        "message": "<Ornament> variant must be one of 'stars' | 'vertical' | 'rule' | 'wound'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Prose'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|style|key|ref|className|style|children)$/]",
        "message": "<Prose> doesn't accept that prop. Declared props: children, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|attribution|variant|ornaments|style|key|ref|className|style|children)$/]",
        "message": "<QuoteBlock> doesn't accept that prop. Declared props: children, attribution, variant, ornaments, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteBlock'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:fragment|closing)$/]",
        "message": "<QuoteBlock> variant must be one of 'fragment' | 'closing'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|glow|id|tight|align|maxWidth|style|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: children, tone, glow, id, tight, align, maxWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:page|deep|night|dawn)$/]",
        "message": "<Section> tone must be one of 'page' | 'deep' | 'night' | 'dawn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='glow'] > Literal[value!=/^(?:none|gold|wound)$/]",
        "message": "<Section> glow must be one of 'none' | 'gold' | 'wound'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Section> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|level|size|italic|align|color|style|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: children, level, size, italic, align, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:hero|display-1|display-2|display-3)$/]",
        "message": "<SectionTitle> size must be one of 'hero' | 'display-1' | 'display-2' | 'display-3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<SectionTitle> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|author|links|legal|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: title, author, links, legal, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
